rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'RESTAURANT_ADMIN' ||
        request.auth.token.email in ['zaykachicken@gmail.com', 'restaurant@zayka.com', 'yashrabalam9@gmail.com'] ||
        request.auth.uid.matches('restaurant_.*')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. ORDERS COLLECTION
    // - Customers can create their own orders and read their own order documents
    // - Only Restaurant Admins can view all orders, accept/reject, and change order status
    match /orders/{orderId} {
      // Customer can read if it's their order; Admin can read all orders
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email
      );

      // Customer can place a new order (initial status must be PLACED)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.status == 'PLACED'
      );

      // Only Restaurant Admin can update order status (Confirm, Prepare, Dispatch, Deliver, Cancel)
      // Customer can only submit rating/feedback on completed orders
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.customerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewFeedback'])
        )
      );

      // Only Admin can delete an order
      allow delete: if isAdmin();
    }

    // 2. MENU COLLECTION
    // - All customers can read available menu items and prices
    // - Only Admins can add, edit prices, delete, or toggle availability
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. DEALS & COUPONS COLLECTION
    // - Customers can view active deals and discounts
    // - Only Admins can create, activate/deactivate, or delete coupon codes
    match /deals/{dealCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. RESTAURANT CONTACT & SETTINGS
    // - Public read for address, contact numbers, hours, and delivery fee
    // - Only Admin can update settings
    match /restaurant_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. USER PROFILES
    // - Each customer can read and update their own profile and saved addresses
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
